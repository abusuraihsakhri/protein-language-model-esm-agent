# Provide a persistent, high-entropy HMAC key when audit verification must
# survive process restarts. Logs themselves are in-memory only.
AUDIT_SECRET_KEY=

# Required to read /api/audit/logs through header X-Audit-Token.
# Keep this value private and do not reuse AUDIT_SECRET_KEY.
AUDIT_LOG_TOKEN=

# Only mock/deterministic/test are implemented; no remote LLM is connected.
MODEL_PROVIDER=mock
HOST=127.0.0.1
PORT=8000
